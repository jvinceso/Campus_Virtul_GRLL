@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="container">
    <div class="row justify-content-center align-items-center" style="min-height: 70vh;">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-body text-center py-5">
                    <!-- Icono de advertencia -->
                    <div class="mb-4">
                        <i class="bi bi-shield-x display-1 text-warning"></i>
                    </div>

                    <!-- Título -->
                    <h1 class="display-5 fw-bold text-danger mb-3">
                        Acceso Denegado
                    </h1>

                    <!-- Mensaje principal -->
                    <p class="lead text-muted mb-4">
                        @(ViewBag.Mensaje ?? "No tienes permisos suficientes para acceder a este recurso.")
                    </p>

                    <!-- Información adicional -->
                    <div class="alert alert-warning mx-auto" style="max-width: 500px;" role="alert">
                        <i class="bi bi-info-circle"></i>
                        <strong>¿Por qué veo este mensaje?</strong><br/>
                        Tu rol actual no incluye los permisos necesarios para realizar esta acción.
                        Si crees que deberías tener acceso, contacta al administrador del sistema.
                    </div>

                    <!-- Información del usuario actual -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="border-top pt-4 mt-4">
                            <p class="text-muted mb-2">
                                <strong>Usuario:</strong> @User.Identity.Name
                            </p>
                            <p class="text-muted mb-0">
                                <strong>Rol:</strong>
                                @if (User.IsInRole("Administrador"))
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-shield-fill-check"></i> Administrador
                                    </span>
                                }
                                else if (User.IsInRole("Profesor"))
                                {
                                    <span class="badge bg-info">
                                        <i class="bi bi-person-badge"></i> Profesor
                                    </span>
                                }
                                else if (User.IsInRole("Colaborador"))
                                {
                                    <span class="badge bg-warning">
                                        <i class="bi bi-person-check"></i> Colaborador
                                    </span>
                                }
                                else if (User.IsInRole("Practicante"))
                                {
                                    <span class="badge bg-secondary">
                                        <i class="bi bi-person"></i> Practicante
                                    </span>
                                }
                            </p>
                        </div>
                    }

                    <!-- Botones de acción -->
                    <div class="d-grid gap-2 mt-4">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-lg">
                                <i class="bi bi-house-door"></i> Ir al Dashboard
                            </a>

                            <button type="button" class="btn btn-outline-secondary" onclick="window.history.back()">
                                <i class="bi bi-arrow-left"></i> Volver atrás
                            </button>
                        }
                        else
                        {
                            <a asp-controller="Login" asp-action="Index" class="btn btn-primary btn-lg">
                                <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesión
                            </a>
                        }
                    </div>

                    <!-- Contacto de soporte -->
                    <div class="mt-4 pt-4 border-top">
                        <p class="text-muted small mb-0">
                            <i class="bi bi-envelope"></i>
                            Si necesitas ayuda, contacta al administrador del sistema.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Información adicional para desarrolladores -->
            @if (ViewContext.HttpContext.Request.Query.ContainsKey("ReturnUrl"))
            {
                <div class="alert alert-secondary mt-3 text-center" role="alert">
                    <small>
                        <strong>URL solicitada:</strong>
                        <code>@ViewContext.HttpContext.Request.Query["ReturnUrl"]</code>
                    </small>
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 15px;
            animation: slideIn 0.5s ease-out;
        }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .bi-shield-x {
            animation: shake 0.5s ease-in-out;
        }

        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-10px); }
            75% { transform: translateX(10px); }
        }
    </style>
}
