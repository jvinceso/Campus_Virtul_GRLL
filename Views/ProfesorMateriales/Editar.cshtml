@model Campus_Virtul_GRLL.Models.ViewModels.EditarMaterialViewModel

@{
    ViewData["Title"] = "Editar Material";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Header -->
            <div class="mb-4">
                <h2>
                    <i class="bi bi-pencil-square text-primary"></i>
                    Editar Material
                </h2>
                <p class="text-muted mb-0">Curso: <strong>@Model.TituloCurso</strong></p>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Editar" method="post">
                        <input type="hidden" asp-for="IdMaterial" />
                        <input type="hidden" asp-for="IdCurso" />
                        <input type="hidden" asp-for="Tipo" />
                        <input type="hidden" asp-for="EsEnlace" />

                        @* Información del archivo actual (solo lectura) *@
                        @if (!Model.EsEnlace)
                        {
                            <div class="alert alert-info mb-4">
                                <div class="d-flex align-items-center">
                                    <i class="@Campus_Virtul_GRLL.Utilities.FileHelper.GetIconByExtension(Model.Extension) fs-2 me-3"></i>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">Archivo Actual</h6>
                                        <div><strong>@Model.NombreArchivo</strong></div>
                                        <small class="text-muted">
                                            Tipo: @Model.Extension
                                            | Tamaño: @Campus_Virtul_GRLL.Utilities.FileValidator.FormatFileSize(Model.TamanoBytes ?? 0)
                                        </small>
                                    </div>
                                </div>
                                <div class="form-text mt-2">
                                    <i class="bi bi-info-circle"></i>
                                    No es posible reemplazar el archivo. Si desea cambiar el archivo, elimine este material y suba uno nuevo.
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info mb-4">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-link-45deg fs-2 me-3"></i>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">Enlace Externo</h6>
                                        <div class="small">
                                            <a href="@Model.UrlExterna" target="_blank" class="text-break">
                                                @Model.UrlExterna
                                                <i class="bi bi-box-arrow-up-right"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @* Título *@
                        <div class="mb-3">
                            <label asp-for="Titulo" class="form-label fw-bold"></label>
                            <input asp-for="Titulo" class="form-control" placeholder="Título del material" />
                            <span asp-validation-for="Titulo" class="text-danger"></span>
                        </div>

                        @* Descripción *@
                        <div class="mb-3">
                            <label asp-for="Descripcion" class="form-label fw-bold"></label>
                            <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Descripción del material"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>

                        @* Módulo *@
                        <div class="mb-3">
                            <label asp-for="IdModuloCurso" class="form-label fw-bold"></label>
                            <select asp-for="IdModuloCurso" class="form-select">
                                <option value="">Sin módulo</option>
                                @foreach (var modulo in Model.ModulosDisponibles)
                                {
                                    <option value="@modulo.IdModuloCurso">@modulo.Titulo</option>
                                }
                            </select>
                            <span asp-validation-for="IdModuloCurso" class="text-danger"></span>
                            <div class="form-text">Seleccione el módulo donde desea organizar este material</div>
                        </div>

                        @* URL Externa (solo para enlaces) *@
                        @if (Model.EsEnlace)
                        {
                            <div class="mb-3">
                                <label asp-for="UrlExterna" class="form-label fw-bold"></label>
                                <input asp-for="UrlExterna" class="form-control" placeholder="https://..." />
                                <span asp-validation-for="UrlExterna" class="text-danger"></span>
                                <div class="form-text">
                                    <i class="bi bi-info-circle"></i>
                                    Puede actualizar la URL del enlace
                                </div>
                            </div>
                        }

                        @* Orden *@
                        <div class="mb-3">
                            <label asp-for="Orden" class="form-label fw-bold"></label>
                            <input asp-for="Orden" type="number" min="1" class="form-control" style="max-width: 150px;" />
                            <span asp-validation-for="Orden" class="text-danger"></span>
                            <div class="form-text">Orden de visualización del material (menor número = aparece primero)</div>
                        </div>

                        @* Visibilidad *@
                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input asp-for="EsVisible" class="form-check-input" type="checkbox" role="switch" id="switchVisible" />
                                <label class="form-check-label fw-bold" for="switchVisible">
                                    <i class="bi bi-eye"></i> @Html.DisplayNameFor(m => m.EsVisible)
                                </label>
                                <div class="form-text">Si está desactivado, el material estará oculto para los estudiantes</div>
                            </div>
                        </div>

                        @* Botones *@
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-grow-1">
                                <i class="bi bi-check-lg"></i> Guardar Cambios
                            </button>
                            <a asp-action="Index" asp-route-idCurso="@Model.IdCurso" class="btn btn-outline-secondary">
                                <i class="bi bi-x-lg"></i> Cancelar
                            </a>
                        </div>

                        <div asp-validation-summary="All" class="text-danger mt-3"></div>
                    </form>
                </div>
            </div>

            @* Card de Información Adicional *@
            <div class="card border-0 shadow-sm mt-3">
                <div class="card-body">
                    <h6 class="mb-3">
                        <i class="bi bi-info-circle text-primary"></i>
                        Información Adicional
                    </h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <small class="text-muted d-block">Tipo de Material</small>
                            <strong>@Model.Tipo</strong>
                        </div>
                        @if (!Model.EsEnlace && Model.Extension != null)
                        {
                            <div class="col-md-6">
                                <small class="text-muted d-block">Extensión</small>
                                <strong>@Model.Extension</strong>
                            </div>
                        }
                    </div>
                    @if (!Model.EsEnlace)
                    {
                        <div class="mt-3">
                            <small class="text-muted">
                                <i class="bi bi-exclamation-triangle"></i>
                                Para reemplazar el archivo, debe eliminar este material y subir uno nuevo.
                            </small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
