@model Campus_Virtul_GRLL.Models.ViewModels.MaterialesProfesorViewModel

@{
    ViewData["Title"] = "Materiales del Curso";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-1">
                        <i class="bi bi-folder-fill text-primary"></i>
                        Materiales del Curso
                    </h2>
                    <p class="text-muted mb-0">@Model.TituloCurso</p>
                </div>
                <div>
                    <a asp-action="Subir" asp-route-idCurso="@Model.IdCurso" class="btn btn-primary">
                        <i class="bi bi-cloud-upload"></i> Subir Material
                    </a>
                    <a asp-controller="AdminCursos" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Volver a Cursos
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Estadísticas -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                                <i class="bi bi-file-earmark-fill text-primary fs-4"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="text-muted mb-1">Total Materiales</h6>
                            <h3 class="mb-0">@Model.TotalMateriales</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="bg-info bg-opacity-10 rounded-circle p-3">
                                <i class="bi bi-hdd-fill text-info fs-4"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="text-muted mb-1">Espacio Utilizado</h6>
                            <h3 class="mb-0">@Campus_Virtul_GRLL.Utilities.FileValidator.FormatFileSize(Model.TamanoTotalBytes)</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Materiales por Módulos *@
    @if (Model.Modulos.Any())
    {
        @foreach (var modulo in Model.Modulos)
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0">
                                <i class="bi bi-collection text-primary"></i>
                                @modulo.Titulo
                            </h5>
                            @if (!string.IsNullOrEmpty(modulo.Descripcion))
                            {
                                <p class="text-muted mb-0 small mt-1">@modulo.Descripcion</p>
                            }
                        </div>
                        <span class="badge bg-primary rounded-pill">@modulo.Materiales.Count materiales</span>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (modulo.Materiales.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 50px;"></th>
                                        <th>Material</th>
                                        <th>Tipo</th>
                                        <th>Tamaño</th>
                                        <th>Descargas</th>
                                        <th>Estado</th>
                                        <th style="width: 200px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var material in modulo.Materiales)
                                    {
                                        <tr>
                                            <td class="text-center">
                                                <i class="@Campus_Virtul_GRLL.Utilities.FileHelper.GetIconByExtension(material.Extension) fs-4"></i>
                                            </td>
                                            <td>
                                                <div>
                                                    <strong>@material.Titulo</strong>
                                                    @if (!string.IsNullOrEmpty(material.Descripcion))
                                                    {
                                                        <br />
                                                        <small class="text-muted">@material.Descripcion</small>
                                                    }
                                                </div>
                                                <small class="text-muted">
                                                    <i class="bi bi-calendar3"></i>
                                                    @material.FechaSubida.ToString("dd/MM/yyyy")
                                                </small>
                                            </td>
                                            <td>
                                                @if (material.EsEnlace)
                                                {
                                                    <span class="badge bg-info">
                                                        <i class="bi bi-link-45deg"></i> Enlace
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@material.Extension</span>
                                                }
                                            </td>
                                            <td>@material.TamanoFormateado</td>
                                            <td>
                                                <span class="badge bg-light text-dark">
                                                    <i class="bi bi-download"></i> @material.NumeroDescargas
                                                </span>
                                            </td>
                                            <td>
                                                @if (material.EsVisible)
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="bi bi-eye"></i> Visible
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">
                                                        <i class="bi bi-eye-slash"></i> Oculto
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    @if (material.EsEnlace)
                                                    {
                                                        <a href="@material.UrlExterna" target="_blank" class="btn btn-outline-primary" title="Abrir enlace">
                                                            <i class="bi bi-box-arrow-up-right"></i>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <a asp-action="Descargar" asp-route-id="@material.IdMaterial" class="btn btn-outline-primary" title="Descargar">
                                                            <i class="bi bi-download"></i>
                                                        </a>
                                                    }
                                                    <button type="button" class="btn btn-outline-secondary btn-toggle-visibilidad" data-id="@material.IdMaterial" data-visible="@material.EsVisible.ToString().ToLower()" title="Cambiar visibilidad">
                                                        <i class="bi @(material.EsVisible ? "bi-eye-slash" : "bi-eye")"></i>
                                                    </button>
                                                    <a asp-action="Editar" asp-route-id="@material.IdMaterial" class="btn btn-outline-info" title="Editar">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    <button type="button" class="btn btn-outline-danger btn-eliminar-material" data-id="@material.IdMaterial" data-titulo="@material.Titulo" title="Eliminar">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="bi bi-inbox fs-1"></i>
                            <p class="mb-0">No hay materiales en este módulo</p>
                        </div>
                    }
                </div>
            </div>
        }
    }

    @* Materiales sin Módulo *@
    @if (Model.MaterialesSinModulo.Any())
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-file-earmark text-secondary"></i>
                        Materiales sin Módulo
                    </h5>
                    <span class="badge bg-secondary rounded-pill">@Model.MaterialesSinModulo.Count materiales</span>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50px;"></th>
                                <th>Material</th>
                                <th>Tipo</th>
                                <th>Tamaño</th>
                                <th>Descargas</th>
                                <th>Estado</th>
                                <th style="width: 200px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var material in Model.MaterialesSinModulo)
                            {
                                <tr>
                                    <td class="text-center">
                                        <i class="@Campus_Virtul_GRLL.Utilities.FileHelper.GetIconByExtension(material.Extension) fs-4"></i>
                                    </td>
                                    <td>
                                        <div>
                                            <strong>@material.Titulo</strong>
                                            @if (!string.IsNullOrEmpty(material.Descripcion))
                                            {
                                                <br />
                                                <small class="text-muted">@material.Descripcion</small>
                                            }
                                        </div>
                                        <small class="text-muted">
                                            <i class="bi bi-calendar3"></i>
                                            @material.FechaSubida.ToString("dd/MM/yyyy")
                                        </small>
                                    </td>
                                    <td>
                                        @if (material.EsEnlace)
                                        {
                                            <span class="badge bg-info">
                                                <i class="bi bi-link-45deg"></i> Enlace
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@material.Extension</span>
                                        }
                                    </td>
                                    <td>@material.TamanoFormateado</td>
                                    <td>
                                        <span class="badge bg-light text-dark">
                                            <i class="bi bi-download"></i> @material.NumeroDescargas
                                        </span>
                                    </td>
                                    <td>
                                        @if (material.EsVisible)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-eye"></i> Visible
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">
                                                <i class="bi bi-eye-slash"></i> Oculto
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            @if (material.EsEnlace)
                                            {
                                                <a href="@material.UrlExterna" target="_blank" class="btn btn-outline-primary" title="Abrir enlace">
                                                    <i class="bi bi-box-arrow-up-right"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-action="Descargar" asp-route-id="@material.IdMaterial" class="btn btn-outline-primary" title="Descargar">
                                                    <i class="bi bi-download"></i>
                                                </a>
                                            }
                                            <button type="button" class="btn btn-outline-secondary btn-toggle-visibilidad" data-id="@material.IdMaterial" data-visible="@material.EsVisible.ToString().ToLower()" title="Cambiar visibilidad">
                                                <i class="bi @(material.EsVisible ? "bi-eye-slash" : "bi-eye")"></i>
                                            </button>
                                            <a asp-action="Editar" asp-route-id="@material.IdMaterial" class="btn btn-outline-info" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-danger btn-eliminar-material" data-id="@material.IdMaterial" data-titulo="@material.Titulo" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @* Sin materiales *@
    @if (!Model.Modulos.Any() && !Model.MaterialesSinModulo.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-inbox text-muted" style="font-size: 4rem;"></i>
                <h4 class="mt-3">No hay materiales en este curso</h4>
                <p class="text-muted">Comienza subiendo tu primer material</p>
                <a asp-action="Subir" asp-route-idCurso="@Model.IdCurso" class="btn btn-primary">
                    <i class="bi bi-cloud-upload"></i> Subir Material
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Eliminar material
        $('.btn-eliminar-material').on('click', function () {
            const id = $(this).data('id');
            const titulo = $(this).data('titulo');

            if (confirm(`¿Está seguro de eliminar el material "${titulo}"?`)) {
                $.ajax({
                    url: '@Url.Action("Eliminar", "ProfesorMateriales")',
                    type: 'POST',
                    data: {
                        id: id,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response.success) {
                            alert(response.message);
                            location.reload();
                        } else {
                            alert('Error: ' + response.message);
                        }
                    },
                    error: function () {
                        alert('Error al eliminar el material');
                    }
                });
            }
        });

        // Toggle visibilidad
        $('.btn-toggle-visibilidad').on('click', function () {
            const btn = $(this);
            const id = btn.data('id');

            $.ajax({
                url: '@Url.Action("ToggleVisibilidad", "ProfesorMateriales")',
                type: 'POST',
                data: {
                    id: id,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function () {
                    alert('Error al cambiar visibilidad');
                }
            });
        });
    </script>
}
