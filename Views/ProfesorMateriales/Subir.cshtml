@model Campus_Virtul_GRLL.Models.ViewModels.SubirMaterialViewModel

@{
    ViewData["Title"] = "Subir Material";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Header -->
            <div class="mb-4">
                <h2>
                    <i class="bi bi-cloud-upload text-primary"></i>
                    Subir Material
                </h2>
                <p class="text-muted mb-0">Curso: <strong>@Model.TituloCurso</strong></p>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Subir" method="post" enctype="multipart/form-data" id="formSubirMaterial">
                        <input type="hidden" asp-for="IdCurso" />
                        <input type="hidden" asp-for="EsModoEnlace" id="esModoEnlace" />

                        @* Selector de modo: Archivo o Enlace *@
                        <div class="mb-4">
                            <label class="form-label fw-bold">Tipo de Material</label>
                            <div class="btn-group w-100" role="group">
                                <input type="radio" class="btn-check" name="modoSubida" id="modoArchivo" value="archivo" checked>
                                <label class="btn btn-outline-primary" for="modoArchivo">
                                    <i class="bi bi-file-earmark-arrow-up"></i> Subir Archivo
                                </label>

                                <input type="radio" class="btn-check" name="modoSubida" id="modoEnlace" value="enlace">
                                <label class="btn btn-outline-primary" for="modoEnlace">
                                    <i class="bi bi-link-45deg"></i> Enlace Externo
                                </label>
                            </div>
                        </div>

                        @* Título *@
                        <div class="mb-3">
                            <label asp-for="Titulo" class="form-label fw-bold"></label>
                            <input asp-for="Titulo" class="form-control" placeholder="Ej: Guía de estudio - Capítulo 1" />
                            <span asp-validation-for="Titulo" class="text-danger"></span>
                        </div>

                        @* Descripción *@
                        <div class="mb-3">
                            <label asp-for="Descripcion" class="form-label fw-bold"></label>
                            <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Descripción opcional del material"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>

                        @* Módulo *@
                        <div class="mb-3">
                            <label asp-for="IdModuloCurso" class="form-label fw-bold"></label>
                            <select asp-for="IdModuloCurso" class="form-select">
                                <option value="">Sin módulo</option>
                                @foreach (var modulo in Model.ModulosDisponibles)
                                {
                                    <option value="@modulo.IdModuloCurso">@modulo.Titulo</option>
                                }
                            </select>
                            <span asp-validation-for="IdModuloCurso" class="text-danger"></span>
                        </div>

                        @* Sección Archivo *@
                        <div id="seccionArchivo" class="mb-4">
                            <div class="card bg-light border-0">
                                <div class="card-body">
                                    <label asp-for="Archivo" class="form-label fw-bold"></label>
                                    <input asp-for="Archivo" type="file" class="form-control" id="inputArchivo" />
                                    <span asp-validation-for="Archivo" class="text-danger"></span>
                                    <div class="form-text">
                                        <i class="bi bi-info-circle"></i>
                                        Tamaño máximo: 50 MB. Formatos permitidos: PDF, Word, Excel, PowerPoint, imágenes, videos, ZIP, RAR
                                    </div>
                                    <div id="previewArchivo" class="mt-3" style="display: none;">
                                        <div class="alert alert-info d-flex align-items-center">
                                            <i class="bi bi-file-earmark-check fs-3 me-3"></i>
                                            <div>
                                                <strong>Archivo seleccionado:</strong>
                                                <div id="nombreArchivo"></div>
                                                <small id="tamanoArchivo" class="text-muted"></small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* Sección Enlace Externo *@
                        <div id="seccionEnlace" class="mb-4" style="display: none;">
                            <div class="card bg-light border-0">
                                <div class="card-body">
                                    <label asp-for="UrlExterna" class="form-label fw-bold"></label>
                                    <input asp-for="UrlExterna" class="form-control" placeholder="https://www.youtube.com/watch?v=..." id="inputUrlExterna" />
                                    <span asp-validation-for="UrlExterna" class="text-danger"></span>
                                    <div class="form-text">
                                        <i class="bi bi-info-circle"></i>
                                        Puede ser un enlace de YouTube, Google Drive, u otro recurso web
                                    </div>

                                    <div class="mt-3">
                                        <label asp-for="TipoMaterial" class="form-label">Tipo de Material (Enlace)</label>
                                        <select asp-for="TipoMaterial" class="form-select" id="selectTipoMaterial">
                                            <option value="">Seleccione...</option>
                                            <option value="Video">Video</option>
                                            <option value="Enlace">Enlace / Recurso Web</option>
                                            <option value="Otro">Otro</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* Visibilidad *@
                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input asp-for="EsVisible" class="form-check-input" type="checkbox" role="switch" id="switchVisible" checked />
                                <label class="form-check-label fw-bold" for="switchVisible">
                                    <i class="bi bi-eye"></i> @Html.DisplayNameFor(m => m.EsVisible)
                                </label>
                                <div class="form-text">Si está desactivado, el material estará oculto para los estudiantes</div>
                            </div>
                        </div>

                        @* Botones *@
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-grow-1">
                                <i class="bi bi-cloud-upload"></i> Subir Material
                            </button>
                            <a asp-action="Index" asp-route-idCurso="@Model.IdCurso" class="btn btn-outline-secondary">
                                <i class="bi bi-x-lg"></i> Cancelar
                            </a>
                        </div>

                        <div asp-validation-summary="All" class="text-danger mt-3"></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $(document).ready(function () {
            // Cambio entre archivo y enlace
            $('input[name="modoSubida"]').on('change', function () {
                const modo = $(this).val();

                if (modo === 'archivo') {
                    $('#seccionArchivo').show();
                    $('#seccionEnlace').hide();
                    $('#esModoEnlace').val('false');
                    $('#inputUrlExterna').val('');
                    $('#selectTipoMaterial').val('');
                } else {
                    $('#seccionArchivo').hide();
                    $('#seccionEnlace').show();
                    $('#esModoEnlace').val('true');
                    $('#inputArchivo').val('');
                    $('#previewArchivo').hide();
                }
            });

            // Preview de archivo seleccionado
            $('#inputArchivo').on('change', function () {
                const archivo = this.files[0];

                if (archivo) {
                    const tamanoMB = (archivo.size / (1024 * 1024)).toFixed(2);
                    $('#nombreArchivo').text(archivo.name);
                    $('#tamanoArchivo').text(`Tamaño: ${tamanoMB} MB`);
                    $('#previewArchivo').show();

                    // Validar tamaño
                    if (archivo.size > 52428800) { // 50 MB
                        alert('El archivo excede el tamaño máximo permitido (50 MB)');
                        $(this).val('');
                        $('#previewArchivo').hide();
                    }
                } else {
                    $('#previewArchivo').hide();
                }
            });

            // Validación del formulario
            $('#formSubirMaterial').on('submit', function (e) {
                const modo = $('input[name="modoSubida"]:checked').val();
                const archivo = $('#inputArchivo')[0].files.length;
                const url = $('#inputUrlExterna').val().trim();

                if (modo === 'archivo' && archivo === 0) {
                    alert('Debe seleccionar un archivo');
                    e.preventDefault();
                    return false;
                }

                if (modo === 'enlace' && url === '') {
                    alert('Debe ingresar una URL');
                    e.preventDefault();
                    return false;
                }

                if (modo === 'enlace') {
                    const tipoMaterial = $('#selectTipoMaterial').val();
                    if (!tipoMaterial) {
                        alert('Debe seleccionar el tipo de material para enlaces');
                        e.preventDefault();
                        return false;
                    }
                }

                return true;
            });
        });
    </script>
}

@section Styles {
    <style>
        .btn-check:checked + .btn-outline-primary {
            background-color: var(--bs-primary);
            color: white;
        }
    </style>
}
