@model Campus_Virtul_GRLL.Models.ViewModels.GestionRolesIndexViewModel

@{
    ViewData["Title"] = "Gestión de Roles";
}

<div class="container-fluid py-4">
    <!-- Encabezado -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="mb-0">
                    <i class="bi bi-shield-check"></i> Gestión de Roles y Permisos
                </h2>
                <a asp-action="ListadoRoles" class="btn btn-primary">
                    <i class="bi bi-shield-lock"></i> Gestionar Roles
                </a>
            </div>
            <p class="text-muted mt-2">Administra los roles de los usuarios del sistema</p>
        </div>
    </div>

    <!-- Tarjetas de estadísticas por rol -->
    <div class="row mb-4">
        @foreach (var rolStat in Model.UsuariosPorRol.OrderByDescending(x => x.Value))
        {
            <div class="col-md-3 mb-3">
                <div class="card @(rolStat.Key == "Administrador" ? "border-danger" : rolStat.Key == "Profesor" ? "border-info" : "border-secondary")">
                    <div class="card-body text-center">
                        @if (rolStat.Key == "Administrador")
                        {
                            <i class="bi bi-shield-fill-check fs-1 text-danger"></i>
                        }
                        else if (rolStat.Key == "Profesor")
                        {
                            <i class="bi bi-person-badge fs-1 text-info"></i>
                        }
                        else if (rolStat.Key == "Colaborador")
                        {
                            <i class="bi bi-person-check fs-1 text-warning"></i>
                        }
                        else
                        {
                            <i class="bi bi-person fs-1 text-secondary"></i>
                        }
                        <h3 class="mt-2 mb-0">@rolStat.Value</h3>
                        <p class="text-muted mb-0">@rolStat.Key</p>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Barra de filtros -->
    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get">
                <div class="row g-3">
                    <!-- Búsqueda -->
                    <div class="col-md-5">
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text"
                                   class="form-control"
                                   name="busqueda"
                                   placeholder="Buscar por nombre o DNI..."
                                   value="@Model.BusquedaTexto">
                        </div>
                    </div>

                    <!-- Filtro por Rol -->
                    <div class="col-md-4">
                        <select class="form-select" name="filtroRol">
                            <option value="">Todos los roles</option>
                            @foreach (var rol in Model.RolesDisponibles)
                            {
                                <option value="@rol.IdRol" selected="@(Model.FiltroRol == rol.IdRol)">
                                    @rol.NombreRol
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Botones -->
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-funnel"></i> Filtrar
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle"></i> Limpiar
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de usuarios con roles -->
    <div class="card">
        <div class="card-body">
            @if (Model.Usuarios.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Usuario</th>
                                <th>DNI</th>
                                <th>Email</th>
                                <th>Área</th>
                                <th>Rol Actual</th>
                                <th>Estado</th>
                                <th>Fecha Creación</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var usuario in Model.Usuarios)
                            {
                                <tr class="@(usuario.EsUsuarioActual ? "table-primary" : "")">
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle bg-primary text-white me-2">
                                                @usuario.NombreCompleto.Substring(0, Math.Min(2, usuario.NombreCompleto.Length))
                                            </div>
                                            <div>
                                                <strong>@usuario.NombreCompleto</strong>
                                                @if (usuario.EsUsuarioActual)
                                                {
                                                    <span class="badge bg-primary ms-2">TÚ</span>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>@usuario.DNI</td>
                                    <td>
                                        <small>@usuario.Email</small>
                                    </td>
                                    <td>
                                        <small class="text-muted">@usuario.Area</small>
                                    </td>
                                    <td>
                                        @if (usuario.RolActual == "Administrador")
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-shield-fill-check"></i> @usuario.RolActual
                                            </span>
                                        }
                                        else if (usuario.RolActual == "Profesor")
                                        {
                                            <span class="badge bg-info">
                                                <i class="bi bi-person-badge"></i> @usuario.RolActual
                                            </span>
                                        }
                                        else if (usuario.RolActual == "Colaborador")
                                        {
                                            <span class="badge bg-warning">
                                                <i class="bi bi-person-check"></i> @usuario.RolActual
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-person"></i> @usuario.RolActual
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (usuario.Estado)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle"></i> Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-x-circle"></i> Inactivo
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <small>@usuario.FechaCreacion.ToString("dd/MM/yyyy")</small>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <!-- Ver permisos del rol -->
                                            <a asp-action="VerPermisos"
                                               asp-route-rolNombre="@usuario.RolActual"
                                               class="btn btn-sm btn-outline-info"
                                               title="Ver permisos">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <!-- Cambiar rol -->
                                            @if (usuario.PuedeCambiarRol)
                                            {
                                                <a asp-action="CambiarRol"
                                                   asp-route-id="@usuario.IdUsuario"
                                                   class="btn btn-sm btn-outline-warning"
                                                   title="Cambiar rol">
                                                    <i class="bi bi-arrow-left-right"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-secondary"
                                                        disabled
                                                        title="No puede cambiar su propio rol">
                                                    <i class="bi bi-lock"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Paginación -->
                @if (Model.TotalPaginas > 1)
                {
                    <nav aria-label="Paginación de usuarios" class="mt-4">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-busqueda="@Model.BusquedaTexto"
                                   asp-route-filtroRol="@Model.FiltroRol"
                                   asp-route-pagina="1">
                                    <i class="bi bi-chevron-double-left"></i>
                                </a>
                            </li>

                            <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-busqueda="@Model.BusquedaTexto"
                                   asp-route-filtroRol="@Model.FiltroRol"
                                   asp-route-pagina="@(Model.PaginaActual - 1)">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>

                            @{
                                int inicio = Math.Max(1, Model.PaginaActual - 2);
                                int fin = Math.Min(Model.TotalPaginas, Model.PaginaActual + 2);

                                for (int i = inicio; i <= fin; i++)
                                {
                                    <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-busqueda="@Model.BusquedaTexto"
                                           asp-route-filtroRol="@Model.FiltroRol"
                                           asp-route-pagina="@i">
                                            @i
                                        </a>
                                    </li>
                                }
                            }

                            <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-busqueda="@Model.BusquedaTexto"
                                   asp-route-filtroRol="@Model.FiltroRol"
                                   asp-route-pagina="@(Model.PaginaActual + 1)">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>

                            <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-busqueda="@Model.BusquedaTexto"
                                   asp-route-filtroRol="@Model.FiltroRol"
                                   asp-route-pagina="@Model.TotalPaginas">
                                    <i class="bi bi-chevron-double-right"></i>
                                </a>
                            </li>
                        </ul>
                        <p class="text-center text-muted">
                            Mostrando página @Model.PaginaActual de @Model.TotalPaginas
                            (@Model.TotalUsuarios usuarios en total)
                        </p>
                    </nav>
                }
            }
            else
            {
                <div class="alert alert-info text-center" role="alert">
                    <i class="bi bi-info-circle fs-2"></i>
                    <p class="mb-0 mt-2">No se encontraron usuarios con los filtros aplicados.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
    <style>
        .avatar-circle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 16px;
        }

        .table-hover tbody tr:hover {
            background-color: rgba(0, 123, 255, 0.05);
        }
    </style>
}
