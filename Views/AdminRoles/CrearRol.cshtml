@model Campus_Virtul_GRLL.Models.ViewModels.CrearRolViewModel

@{
    ViewData["Title"] = "Crear Nuevo Rol";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Encabezado -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>
                    <i class="bi bi-plus-circle"></i> Crear Nuevo Rol
                </h2>
                <a asp-action="ListadoRoles" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Volver al listado
                </a>
            </div>

            <!-- Información -->
            <div class="alert alert-info" role="alert">
                <i class="bi bi-info-circle"></i>
                <strong>Información:</strong>
                Después de crear el rol, podrás gestionar sus permisos específicos desde el listado de roles.
            </div>

            <!-- Mensajes de validación -->
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <!-- Formulario -->
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-shield-plus"></i> Datos del Nuevo Rol
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="CrearRol" method="post">
                        @Html.AntiForgeryToken()

                        <!-- Nombre del Rol -->
                        <div class="mb-4">
                            <label asp-for="NombreRol" class="form-label">
                                <strong>Nombre del Rol</strong> <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-shield"></i></span>
                                <input asp-for="NombreRol"
                                       class="form-control"
                                       placeholder="Ej: Supervisor, Auditor, etc."
                                       maxlength="50"
                                       required />
                            </div>
                            <span asp-validation-for="NombreRol" class="text-danger small"></span>
                            <small class="form-text text-muted">
                                Máximo 50 caracteres. El nombre debe ser único.
                            </small>
                        </div>

                        <!-- Descripción -->
                        <div class="mb-4">
                            <label asp-for="Descripcion" class="form-label">
                                <strong>Descripción</strong> <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Descripcion"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Describe las responsabilidades y alcance de este rol..."
                                      maxlength="200"
                                      required></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                            <small class="form-text text-muted">
                                Máximo 200 caracteres. Describe brevemente el propósito del rol.
                            </small>
                        </div>

                        <!-- Estado -->
                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input asp-for="Estado"
                                       class="form-check-input"
                                       type="checkbox"
                                       role="switch"
                                       id="switchEstado" />
                                <label class="form-check-label" for="switchEstado">
                                    <strong>Rol Activo</strong>
                                </label>
                            </div>
                            <small class="form-text text-muted">
                                Si está activo, el rol estará disponible para asignar a usuarios.
                            </small>
                        </div>

                        <!-- Botones de acción -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="ListadoRoles" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle"></i> Crear Rol
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Card de ayuda -->
            <div class="card mt-4 border-primary">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-question-circle text-primary"></i> Siguientes Pasos
                    </h5>
                    <ol class="mb-0">
                        <li>Crea el rol con nombre y descripción claros</li>
                        <li>Una vez creado, ve al listado de roles</li>
                        <li>Usa el botón <i class="bi bi-key"></i> para gestionar los permisos del rol</li>
                        <li>Asigna permisos específicos para cada módulo del sistema</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            // Actualizar contador de caracteres para nombre
            $('#NombreRol').on('input', function() {
                const length = $(this).val().length;
                const max = 50;
                if (length > 0) {
                    $(this).addClass('is-valid').removeClass('is-invalid');
                }
            });

            // Actualizar contador de caracteres para descripción
            $('#Descripcion').on('input', function() {
                const length = $(this).val().length;
                const max = 200;
                if (length > 0) {
                    $(this).addClass('is-valid').removeClass('is-invalid');
                }
            });
        });
    </script>
}
