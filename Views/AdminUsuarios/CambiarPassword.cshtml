@model Campus_Virtul_GRLL.Models.ViewModels.CambiarPasswordViewModel

@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <!-- Encabezado -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>
                    <i class="bi bi-key-fill"></i> Cambiar Contraseña
                </h2>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Volver
                </a>
            </div>

            <!-- Información del usuario -->
            <div class="card shadow mb-4">
                <div class="card-body bg-light">
                    <div class="d-flex align-items-center">
                        <div class="avatar-circle bg-primary text-white me-3">
                            @Model.NombreCompleto.Substring(0, Math.Min(2, Model.NombreCompleto.Length))
                        </div>
                        <div>
                            <h5 class="mb-1">@Model.NombreCompleto</h5>
                            <p class="text-muted mb-0">
                                <i class="bi bi-person-badge"></i> DNI: @Model.DNI
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Información importante -->
            <div class="alert alert-info" role="alert">
                <i class="bi bi-info-circle"></i>
                <strong>Información:</strong> Como administrador, puede establecer una nueva contraseña sin requerir la contraseña actual del usuario.
            </div>

            <!-- Mensajes de validación -->
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <!-- Formulario -->
            <div class="card shadow">
                <div class="card-body">
                    <form asp-action="CambiarPassword" method="post" id="formCambiarPassword">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="IdUsuario" />
                        <input type="hidden" asp-for="NombreCompleto" />
                        <input type="hidden" asp-for="DNI" />

                        <!-- Nueva Contraseña -->
                        <div class="mb-4">
                            <label asp-for="NuevaContrasena" class="form-label">
                                Nueva Contraseña <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input asp-for="NuevaContrasena"
                                       type="password"
                                       class="form-control"
                                       id="nuevaPassword"
                                       placeholder="Ingrese la nueva contraseña" />
                                <button class="btn btn-outline-secondary"
                                        type="button"
                                        id="toggleNuevaPassword">
                                    <i class="bi bi-eye" id="iconNuevaPassword"></i>
                                </button>
                            </div>
                            <span asp-validation-for="NuevaContrasena" class="text-danger small"></span>

                            <!-- Indicador de fortaleza de contraseña -->
                            <div class="progress mt-2" style="height: 5px;">
                                <div class="progress-bar" id="passwordStrength" role="progressbar" style="width: 0%"></div>
                            </div>
                            <small class="text-muted" id="passwordStrengthText">Mínimo 6 caracteres</small>
                        </div>

                        <!-- Confirmar Contraseña -->
                        <div class="mb-4">
                            <label asp-for="ConfirmarContrasena" class="form-label">
                                Confirmar Nueva Contraseña <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-lock-fill"></i>
                                </span>
                                <input asp-for="ConfirmarContrasena"
                                       type="password"
                                       class="form-control"
                                       id="confirmarPassword"
                                       placeholder="Confirme la nueva contraseña" />
                                <button class="btn btn-outline-secondary"
                                        type="button"
                                        id="toggleConfirmarPassword">
                                    <i class="bi bi-eye" id="iconConfirmarPassword"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
                            <small class="text-muted" id="passwordMatchText"></small>
                        </div>

                        <!-- Requisitos de contraseña -->
                        <div class="card bg-light mb-4">
                            <div class="card-body">
                                <h6 class="card-title">
                                    <i class="bi bi-shield-check"></i> Requisitos de Contraseña
                                </h6>
                                <ul class="mb-0 small">
                                    <li id="req-length" class="text-muted">
                                        <i class="bi bi-circle"></i> Mínimo 6 caracteres
                                    </li>
                                    <li id="req-match" class="text-muted">
                                        <i class="bi bi-circle"></i> Las contraseñas deben coincidir
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <!-- Advertencia de seguridad -->
                        <div class="alert alert-warning" role="alert">
                            <i class="bi bi-exclamation-triangle"></i>
                            <strong>Importante:</strong> La nueva contraseña será establecida como contraseña permanente y el usuario podrá iniciar sesión inmediatamente.
                        </div>

                        <!-- Botones de acción -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Detalle" asp-route-id="@Model.IdUsuario" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary" id="btnSubmit">
                                <i class="bi bi-check-circle"></i> Cambiar Contraseña
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .avatar-circle {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 20px;
        }

        .progress-bar {
            transition: width 0.3s ease, background-color 0.3s ease;
        }

        .req-met {
            color: #28a745 !important;
        }

        .req-met i {
            color: #28a745;
        }

        .req-unmet {
            color: #dc3545 !important;
        }

        .req-unmet i {
            color: #dc3545;
        }
    </style>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            // ============================================
            // Toggle password visibility
            // ============================================
            $('#toggleNuevaPassword').on('click', function() {
                const passwordField = $('#nuevaPassword');
                const icon = $('#iconNuevaPassword');

                if (passwordField.attr('type') === 'password') {
                    passwordField.attr('type', 'text');
                    icon.removeClass('bi-eye').addClass('bi-eye-slash');
                } else {
                    passwordField.attr('type', 'password');
                    icon.removeClass('bi-eye-slash').addClass('bi-eye');
                }
            });

            $('#toggleConfirmarPassword').on('click', function() {
                const passwordField = $('#confirmarPassword');
                const icon = $('#iconConfirmarPassword');

                if (passwordField.attr('type') === 'password') {
                    passwordField.attr('type', 'text');
                    icon.removeClass('bi-eye').addClass('bi-eye-slash');
                } else {
                    passwordField.attr('type', 'password');
                    icon.removeClass('bi-eye-slash').addClass('bi-eye');
                }
            });

            // ============================================
            // Password strength indicator
            // ============================================
            $('#nuevaPassword').on('keyup', function() {
                const password = $(this).val();
                const length = password.length;
                let strength = 0;
                let color = '';
                let text = '';

                if (length === 0) {
                    strength = 0;
                    color = '';
                    text = 'Mínimo 6 caracteres';
                } else if (length < 6) {
                    strength = 25;
                    color = 'bg-danger';
                    text = 'Muy débil - Necesita al menos 6 caracteres';
                } else if (length < 8) {
                    strength = 50;
                    color = 'bg-warning';
                    text = 'Débil - Considere usar más caracteres';
                } else if (length < 12) {
                    strength = 75;
                    color = 'bg-info';
                    text = 'Buena';
                } else {
                    strength = 100;
                    color = 'bg-success';
                    text = 'Excelente';
                }

                $('#passwordStrength')
                    .removeClass('bg-danger bg-warning bg-info bg-success')
                    .addClass(color)
                    .css('width', strength + '%');

                $('#passwordStrengthText').text(text);

                // Validar requisito de longitud
                if (length >= 6) {
                    $('#req-length').removeClass('text-muted req-unmet').addClass('req-met');
                    $('#req-length i').removeClass('bi-circle bi-x-circle').addClass('bi-check-circle');
                } else {
                    $('#req-length').removeClass('req-met').addClass('req-unmet');
                    $('#req-length i').removeClass('bi-circle bi-check-circle').addClass('bi-x-circle');
                }

                // Validar coincidencia
                validarCoincidencia();
            });

            // ============================================
            // Validar coincidencia de contraseñas
            // ============================================
            function validarCoincidencia() {
                const password = $('#nuevaPassword').val();
                const confirmar = $('#confirmarPassword').val();

                if (confirmar.length === 0) {
                    $('#passwordMatchText').text('');
                    $('#req-match').removeClass('req-met req-unmet').addClass('text-muted');
                    $('#req-match i').removeClass('bi-check-circle bi-x-circle').addClass('bi-circle');
                    return;
                }

                if (password === confirmar && password.length >= 6) {
                    $('#passwordMatchText').text('✓ Las contraseñas coinciden').removeClass('text-danger').addClass('text-success');
                    $('#confirmarPassword').removeClass('is-invalid').addClass('is-valid');
                    $('#req-match').removeClass('text-muted req-unmet').addClass('req-met');
                    $('#req-match i').removeClass('bi-circle bi-x-circle').addClass('bi-check-circle');
                } else {
                    $('#passwordMatchText').text('✗ Las contraseñas no coinciden').removeClass('text-success').addClass('text-danger');
                    $('#confirmarPassword').removeClass('is-valid').addClass('is-invalid');
                    $('#req-match').removeClass('req-met').addClass('req-unmet');
                    $('#req-match i').removeClass('bi-circle bi-check-circle').addClass('bi-x-circle');
                }
            }

            $('#confirmarPassword').on('keyup', validarCoincidencia);

            // ============================================
            // Confirmación antes de enviar
            // ============================================
            $('#formCambiarPassword').on('submit', function(e) {
                const nombreUsuario = '@Model.NombreCompleto';
                const password = $('#nuevaPassword').val();
                const confirmar = $('#confirmarPassword').val();

                // Validación adicional
                if (password.length < 6) {
                    e.preventDefault();
                    alert('La contraseña debe tener al menos 6 caracteres.');
                    return false;
                }

                if (password !== confirmar) {
                    e.preventDefault();
                    alert('Las contraseñas no coinciden.');
                    return false;
                }

                if (!confirm(`¿Está seguro de cambiar la contraseña de ${nombreUsuario}?`)) {
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}
