@model Campus_Virtul_GRLL.Models.ViewModels.CrearUsuarioViewModel

@{
    ViewData["Title"] = "Crear Nuevo Usuario";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Encabezado -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>
                    <i class="bi bi-person-plus-fill"></i> Crear Nuevo Usuario
                </h2>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Volver al listado
                </a>
            </div>

            <!-- Mensajes de validación -->
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <!-- Formulario -->
            <div class="card shadow">
                <div class="card-body">
                    <form asp-action="Crear" method="post">
                        @Html.AntiForgeryToken()

                        <!-- Sección: Información Personal -->
                        <h5 class="card-title mb-3 pb-2 border-bottom">
                            <i class="bi bi-person-vcard"></i> Información Personal
                        </h5>

                        <div class="row mb-3">
                            <!-- Nombres -->
                            <div class="col-md-6">
                                <label asp-for="Nombres" class="form-label">
                                    Nombres <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Nombres" class="form-control" placeholder="Ej: Juan Carlos" />
                                <span asp-validation-for="Nombres" class="text-danger small"></span>
                            </div>

                            <!-- Apellidos -->
                            <div class="col-md-6">
                                <label asp-for="Apellidos" class="form-label">
                                    Apellidos <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Apellidos" class="form-control" placeholder="Ej: Pérez García" />
                                <span asp-validation-for="Apellidos" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <!-- DNI -->
                            <div class="col-md-6">
                                <label asp-for="DNI" class="form-label">
                                    DNI <span class="text-danger">*</span>
                                </label>
                                <input asp-for="DNI" class="form-control" placeholder="Ej: 12345678" maxlength="8" />
                                <span asp-validation-for="DNI" class="text-danger small"></span>
                                <small class="form-text text-muted">Debe contener exactamente 8 dígitos</small>
                            </div>

                            <!-- Teléfono -->
                            <div class="col-md-6">
                                <label asp-for="Telefono" class="form-label">Teléfono</label>
                                <input asp-for="Telefono" class="form-control" placeholder="Ej: 987654321" />
                                <span asp-validation-for="Telefono" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Sección: Información de Contacto -->
                        <h5 class="card-title mb-3 pb-2 border-bottom mt-4">
                            <i class="bi bi-envelope"></i> Información de Contacto
                        </h5>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">
                                Correo Electrónico <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Email" class="form-control" placeholder="Ej: usuario@campusvirtual.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                            <small class="form-text text-muted">Este será el email de acceso al sistema</small>
                        </div>

                        <!-- Sección: Información Laboral -->
                        <h5 class="card-title mb-3 pb-2 border-bottom mt-4">
                            <i class="bi bi-building"></i> Información Laboral
                        </h5>

                        <div class="row mb-3">
                            <!-- Área -->
                            <div class="col-md-6">
                                <label asp-for="Area" class="form-label">
                                    Área <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Area" class="form-select">
                                    <option value="">-- Seleccione un área --</option>
                                    @foreach (var area in Model.AreasDisponibles)
                                    {
                                        <option value="@area">@area</option>
                                    }
                                </select>
                                <span asp-validation-for="Area" class="text-danger small"></span>
                            </div>

                            <!-- Rol -->
                            <div class="col-md-6">
                                <label asp-for="IdRol" class="form-label">
                                    Rol <span class="text-danger">*</span>
                                </label>
                                <select asp-for="IdRol" class="form-select">
                                    <option value="">-- Seleccione un rol --</option>
                                    @foreach (var rol in Model.RolesDisponibles)
                                    {
                                        <option value="@rol.IdRol">@rol.NombreRol</option>
                                    }
                                </select>
                                <span asp-validation-for="IdRol" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Estado -->
                        <div class="mb-3">
                            <label asp-for="Estado" class="form-label">
                                Estado <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Estado" class="form-select">
                                <option value="true">Activo</option>
                                <option value="false">Inactivo</option>
                            </select>
                            <span asp-validation-for="Estado" class="text-danger small"></span>
                        </div>

                        <!-- Sección: Seguridad -->
                        <h5 class="card-title mb-3 pb-2 border-bottom mt-4">
                            <i class="bi bi-shield-lock"></i> Contraseña Inicial
                        </h5>

                        <div class="alert alert-info" role="alert">
                            <i class="bi bi-info-circle"></i>
                            La contraseña será establecida directamente como permanente (sin primer inicio).
                        </div>

                        <div class="row mb-3">
                            <!-- Contraseña -->
                            <div class="col-md-6">
                                <label asp-for="Contrasena" class="form-label">
                                    Contraseña <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <input asp-for="Contrasena" type="password" class="form-control" id="password" />
                                    <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                        <i class="bi bi-eye" id="togglePasswordIcon"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Contrasena" class="text-danger small"></span>
                                <small class="form-text text-muted">Mínimo 6 caracteres</small>
                            </div>

                            <!-- Confirmar Contraseña -->
                            <div class="col-md-6">
                                <label asp-for="ConfirmarContrasena" class="form-label">
                                    Confirmar Contraseña <span class="text-danger">*</span>
                                </label>
                                <input asp-for="ConfirmarContrasena" type="password" class="form-control" />
                                <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Botones de acción -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-save"></i> Crear Usuario
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            // ============================================
            // Toggle password visibility
            // ============================================
            $('#togglePassword').on('click', function() {
                const passwordField = $('#password');
                const passwordFieldType = passwordField.attr('type');
                const icon = $('#togglePasswordIcon');

                if (passwordFieldType === 'password') {
                    passwordField.attr('type', 'text');
                    icon.removeClass('bi-eye').addClass('bi-eye-slash');
                } else {
                    passwordField.attr('type', 'password');
                    icon.removeClass('bi-eye-slash').addClass('bi-eye');
                }
            });

            // ============================================
            // Validación de DNI (solo números)
            // ============================================
            $('#DNI').on('keypress', function(e) {
                const charCode = e.which ? e.which : e.keyCode;
                if (charCode < 48 || charCode > 57) {
                    e.preventDefault();
                    return false;
                }
            });

            // ============================================
            // Validación de Teléfono (solo números)
            // ============================================
            $('#Telefono').on('keypress', function(e) {
                const charCode = e.which ? e.which : e.keyCode;
                if (charCode < 48 || charCode > 57) {
                    e.preventDefault();
                    return false;
                }
            });

            // ============================================
            // Validación de Email en tiempo real
            // ============================================
            $('#Email').on('blur', function() {
                const email = $(this).val();
                const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

                if (email && !emailRegex.test(email)) {
                    $(this).addClass('is-invalid');
                } else {
                    $(this).removeClass('is-invalid');
                }
            });

            // ============================================
            // Confirmación antes de enviar
            // ============================================
            $('form').on('submit', function(e) {
                const nombres = $('#Nombres').val();
                const apellidos = $('#Apellidos').val();
                const rol = $('#IdRol option:selected').text();

                if (!confirm(`¿Está seguro de crear el usuario ${nombres} ${apellidos} con el rol de ${rol}?`)) {
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}
